# ─── Normaliser les line endings → LF sur tous les OS ────────────────────────
* text=auto eol=lf

# ─── Fichiers texte explicites ────────────────────────────────────────────────
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.xml       text eol=lf
*.html      text eol=lf

# ─── Fichiers binaires (pas de conversion) ────────────────────────────────────
*.pfx       binary
*.p12       binary
*.ots       binary
*.tsr       binary
*.seal      binary
*.png       binary
*.jpg       binary
*.pdf       binary
*.zip       binary
